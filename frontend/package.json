{
  "name": "construprice-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "api": "json-server --watch db.json --port 4001",
    "dev:all": "concurrently \"npm run dev\" \"npm run api\"",
    "start:all": "concurrently \"npm run backend\" \"npm run dev\"",
    "backend": "cd ../backend && python main.py",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.12.25",
    "@fontsource-variable/geist": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@nextui-org/react": "^2.6.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "driver.js": "^1.4.0",
    "framer-motion": "^12.37.0",
    "lucide-react": "^0.577.0",
    "motion": "^12.37.0",
    "next": "^14.2.33",
    "radix-ui": "^1.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.71.2",
    "react-image-crop": "^11.0.10",
    "react-router-dom": "^6.30.1",
    "shadcn": "^4.0.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
