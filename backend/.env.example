# ==============================================
# BACKEND — DESENVOLVIMENTO LOCAL
# ==============================================
# Copie para .env e preencha os valores.
# Para prod, copie .env.production e use APP_ENV=production

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Banco de dados
DATABASE_URL=postgresql+asyncpg://localhost/construprice
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=15

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Scraping
MAX_CONCURRENT_SCRAPERS=5
SCRAPING_TIMEOUT=15
GIGAVALE_CHROME_BINARY=
SELENIUM_REMOTE_URL=
# 1 = Gigavale usa SÓ cookies semeados (seed_gigavale_session.py); não tenta Selenium
GIGAVALE_MANUAL_SESSION_ONLY=0

# Seguranca
CREDENTIALS_ENCRYPTION_KEY=
JWT_SECRET=dev-secret-change-in-prod

# Dominio
APP_BASE_DOMAIN=localhost:3000
NEXT_PUBLIC_DEFAULT_TENANT=

# Email
RESEND_API_KEY=
RESEND_FROM=PriceTracker <onboarding@resend.dev>

# IA / LLMs
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=

# GitHub (feedback agent)
GITHUB_TOKEN=
GITHUB_REPO=
GIT_BASE_BRANCH=main
GIT_PUSH_ENABLED=false
VERCEL_PREVIEW_PATTERN=

# Credenciais de fornecedores
SUPPLIER_ESTOQUE_MEGALESTE_USERNAME=
SUPPLIER_ESTOQUE_MEGALESTE_PASSWORD=
SUPPLIER_COFEMA_MATERIAIS_USERNAME=
SUPPLIER_COFEMA_MATERIAIS_PASSWORD=
SUPPLIER_ESTOQUE_ATACADISTA_USERNAME=
SUPPLIER_ESTOQUE_ATACADISTA_PASSWORD=
