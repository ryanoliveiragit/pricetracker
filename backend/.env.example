# ==============================================
# CONFIGURAÇÕES DA API
# ==============================================
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# ==============================================
# CORS - Origens permitidas
# ==============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ==============================================
# SCRAPING
# ==============================================
MAX_CONCURRENT_SCRAPERS=5
SCRAPING_TIMEOUT=15

# ==============================================
# IA (para sugestão de variantes de produtos)
# ==============================================
# Groq (gratuito): https://console.groq.com
GROQ_API_KEY=

# ==============================================
# GITHUB — criação de branch via API (sem git local)
# ==============================================
# Token: https://github.com/settings/tokens  (scope: repo)
GITHUB_TOKEN=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
# Formato: owner/repo
GITHUB_REPO=ryanoliveiragit/pricetracker
GIT_BASE_BRANCH=main
# Opcional: URL de preview Vercel por branch
# VERCEL_PREVIEW_PATTERN=https://pricetracker-git-{branch}-SEU-TEAM.vercel.app

# ==============================================
# SEGURANÇA - Chave de criptografia de credenciais
# ==============================================
# Gerar uma chave: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

# ==============================================
# CREDENCIAIS DOS FORNECEDORES
# ==============================================
# Formato: SUPPLIER_{NOME_DO_FORNECEDOR}_USERNAME e _PASSWORD
# O nome deve ser normalizado (sem espaços, maiúsculas, sem caracteres especiais)

# Estoque Megaleste
SUPPLIER_ESTOQUE_MEGALESTE_USERNAME=
SUPPLIER_ESTOQUE_MEGALESTE_PASSWORD=

# Cofema Materiais (não requer login atualmente)
SUPPLIER_COFEMA_MATERIAIS_USERNAME=
SUPPLIER_COFEMA_MATERIAIS_PASSWORD=

# Estoque Atacadista
SUPPLIER_ESTOQUE_ATACADISTA_USERNAME=
SUPPLIER_ESTOQUE_ATACADISTA_PASSWORD=

# ==============================================
# EXEMPLOS DE USO
# ==============================================
# Para adicionar um novo fornecedor:
# 1. Criar variáveis no formato acima
# 2. Normalizar o nome (remover espaços, usar underscores)
# 3. Adicionar as credenciais
#
# Exemplo para "Loja ABC":
# SUPPLIER_LOJA_ABC_USERNAME=meu_usuario
# SUPPLIER_LOJA_ABC_PASSWORD=minha_senha_segura
