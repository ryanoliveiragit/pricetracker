# pyenv
#   For a library or binary, you shouldn't ignore this file.
# .python-version

# pipenv
#   According to pypa/pipenv#1191, it is recommended to not ignore Pipfile.lock.
#   If you are part of a project that contains personal/sensitive data,
#   you should probably not commit Pipfile.lock in version control.
# Pipfile.lock

# poetry
#   Similar to Pipenv, it is generally recommended to not ignore poetry.lock.
#   poetry.lock

# pdm
#   Similar to Pipenv, it is generally recommended to not ignore pdm.lock.
# pdm.lock
#   pdm.toml is generally not ignored, as it contains project-wide settings.
# .pdm-python
# .pdm-build/

# PEP 582; used by e.g. github.com/pdm-project/pdm
